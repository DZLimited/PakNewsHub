# Copy to server/.env and adjust.
PORT=5000
# Local MongoDB, or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/paknewshub
# Allowed browser origins (comma-separated). Not needed when using the Vite proxy.
CORS_ORIGIN=http://localhost:5173
# Set to "production" to also serve the built frontend from ../dist
NODE_ENV=development
