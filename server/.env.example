# Copy to server/.env and adjust.
PORT=5000
# Local MongoDB, or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/paknewshub
# Allowed browser origins (comma-separated). Not needed when using the Vite proxy.
CORS_ORIGIN=http://localhost:5173
# Set to "production" to also serve the built frontend from ../dist
NODE_ENV=development
# How often the worker (npm run worker) fetches the RSS feeds, in minutes
INGEST_INTERVAL_MINUTES=15

# ── Urdu translation (Claude) ─────────────────────────────
# OFF by default because every translation is a paid API call.
# 1. Put your key here (https://platform.claude.com → API keys)
# ANTHROPIC_API_KEY=sk-ant-...   (uncomment and paste your key)
# 2. Try a few first:      npm run translate -- --limit 5
# 3. Then turn it on for the worker (translates new stories every minute):
URDU_TRANSLATION=off
# Model: claude-opus-5-5 (best quality, ~1.2¢/story) or
#        claude-haiku-5-5 (much cheaper, ~0.03¢/story). Estimates, not quotes.
URDU_MODEL=claude-opus-5-5
URDU_BATCH_SIZE=20
